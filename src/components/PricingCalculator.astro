---
---

<div class="pricing-display-bar" data-reveal>
  <div class="pricing-display-glass">
    <div class="pricing-display-left">
      <p class="pricing-display-label">Selected month</p>
      <p class="pricing-display-month" id="promo-live-month">July 2026</p>
    </div>
    <div class="pricing-display-center">
      <p class="pricing-display-price" id="promo-live-price" aria-live="polite">$49.50</p>
      <p class="pricing-display-period">per year</p>
    </div>
    <div class="pricing-display-right">
      <span class="pricing-discount-badge" id="promo-live-discount">90% OFF</span>
      <p class="pricing-display-savings" id="promo-live-savings">Save $445.50</p>
    </div>
  </div>
</div>

<div class="pricing-visual-stage" data-reveal>
  <div class="pricing-columns" id="pricing-columns" role="group" aria-label="Monthly pricing tiers"></div>
  <div class="pricing-slider-rail">
    <div class="pricing-slider-track-bg">
      <div class="promo-slider-fill" id="promo-slider-fill"></div>
      <div class="pricing-slider-thumb-glow" id="promo-thumb-glow" aria-hidden="true"></div>
    </div>
    <input
      type="range"
      id="promo-price-slider"
      class="promo-price-slider"
      min="0"
      max="9"
      value="0"
      step="1"
      aria-label="Select month to see promotional pricing"
      aria-describedby="promo-slider-hint"
    />
  </div>
  <p class="pricing-slider-hint" id="promo-slider-hint">
    July $49.50 → August $99 → … → full price $495 from April 2027. Pay securely with Stripe below or email to order.
  </p>
</div>

<!-- Stripe Checkout Slot -->
<section class="promo-checkout" id="checkout" aria-labelledby="checkout-heading">
  <div class="container">
    <div class="promo-checkout-inner">
      <p class="section-eyebrow">Pay securely</p>
      <h2 id="checkout-heading">Ready to claim your page?</h2>
      <p class="promo-checkout-lead">
        Checkout takes under a minute. Apply coupon <strong>BW-90</strong> for your July 90% introductory discount ($49.50). Or email us to discuss your requirements first.
      </p>

      <div id="stripe-checkout-slot" class="stripe-checkout-slot">
        <p class="stripe-coupon-hint">Signing up in July? Apply coupon <strong>BW-90</strong> at checkout for 90% off.</p>
        <script async src="https://js.stripe.com/v3/buy-button.js"></script>
        <stripe-buy-button
          buy-button-id="buy_btn_1TjH5PDRtLu90m8j4O1g5xA5"
          publishable-key="pk_live_6TrCubeAphhHGIDlKHpcluuS"
        ></stripe-buy-button>
        <p class="stripe-link-fallback">
          <a href="https://buy.stripe.com/3cIeVdcVMezo1st51f77O00" target="_blank" rel="noopener noreferrer">
            Open Stripe checkout in a new tab →
          </a>
        </p>
      </div>

      <div class="promo-checkout-alt">
        <a href="mailto:col@oze.com.au?subject=bellwest.au%20promo%20page%20order%20(July%202026%20-%20$49.50)&body=Hi%20Colin,%0A%0AI%20would%20like%20to%20order%20a%20promo%20page%20on%20bellwest.au%20for%20July%202026%20at%20$49.50/year.%0A%0ABusiness/Property%20Name:%0APhone:%0APreferred%20URL:%20bellwest.au/" class="btn btn-secondary" id="promo-order-btn">
          Order by email — <span id="promo-order-price-label">$49.50</span>
        </a>
        <a href="#claim-form" class="btn btn-secondary">Full inquiry form</a>
      </div>
    </div>
  </div>
</section>

<script>
  function initPricing() {
    const BASE_PRICE = 495;
    const PRICING_MONTHS = [
      { label: 'July 2026', short: 'Jul', discount: 90 },
      { label: 'August 2026', short: 'Aug', discount: 80 },
      { label: 'September 2026', short: 'Sep', discount: 70 },
      { label: 'October 2026', short: 'Oct', discount: 60 },
      { label: 'November 2026', short: 'Nov', discount: 50 },
      { label: 'December 2026', short: 'Dec', discount: 40 },
      { label: 'January 2027', short: 'Jan', discount: 30 },
      { label: 'February 2027', short: 'Feb', discount: 20 },
      { label: 'March 2027', short: 'Mar', discount: 10 },
      { label: 'April 2027+', short: 'Full', discount: 0 },
    ];

    function formatPrice(amount: number) {
      return amount % 1 === 0 ? '$' + amount.toFixed(0) : '$' + amount.toFixed(2);
    }

    function getTier(index: number) {
      const tier = PRICING_MONTHS[index] || PRICING_MONTHS[PRICING_MONTHS.length - 1];
      const price = BASE_PRICE * (1 - tier.discount / 100);
      const savings = BASE_PRICE - price;
      return { ...tier, price, savings, index };
    }

    const columnsEl = document.getElementById('pricing-columns');
    const slider = document.getElementById('promo-price-slider') as HTMLInputElement | null;
    const fillEl = document.getElementById('promo-slider-fill');
    const glowEl = document.getElementById('promo-thumb-glow');
    const monthEl = document.getElementById('promo-live-month');
    const priceEl = document.getElementById('promo-live-price');
    const discountEl = document.getElementById('promo-live-discount');
    const savingsEl = document.getElementById('promo-live-savings');
    const orderBtn = document.getElementById('promo-order-btn') as HTMLAnchorElement | null;
    const orderPriceLabel = document.getElementById('promo-order-price-label');

    if (!columnsEl || !slider) return;

    // Render columns
    columnsEl.innerHTML = PRICING_MONTHS.map((tier, i) => {
      const t = getTier(i);
      const height = Math.max(18, Math.round((t.price / BASE_PRICE) * 100));
      return `
        <button type="button" class="pricing-col ${i === 0 ? 'is-active' : ''}" data-index="${i}" aria-label="${tier.label}, ${formatPrice(t.price)}">
          <div class="pricing-col-bar" style="--bar-height:${height}%;">
            <span class="pricing-col-price">${formatPrice(t.price)}</span>
          </div>
          <span class="pricing-col-month">${tier.short}</span>
          <span class="pricing-col-off ${tier.discount === 0 ? 'is-full' : ''}">${tier.discount > 0 ? '-' + tier.discount + '%' : 'Full'}</span>
        </button>
      `;
    }).join('');

    function updateTier(index: number) {
      const t = getTier(index);
      slider.value = String(index);

      if (monthEl) monthEl.textContent = t.label;
      if (priceEl) priceEl.textContent = formatPrice(t.price);
      if (discountEl) discountEl.textContent = t.discount > 0 ? `${t.discount}% OFF` : 'STANDARD';
      if (savingsEl) savingsEl.textContent = t.discount > 0 ? `Save ${formatPrice(t.savings)}` : 'Standard annual rate';
      if (orderPriceLabel) orderPriceLabel.textContent = formatPrice(t.price);

      if (orderBtn) {
        const subject = encodeURIComponent(`bellwest.au promo page order (${t.label} - ${formatPrice(t.price)})`);
        const body = encodeURIComponent(
          `Hi Colin,\n\nI would like to order a promo page on bellwest.au for ${t.label} at ${formatPrice(t.price)}/year.\n\nBusiness/Property Name:\nPhone:\nPreferred URL: bellwest.au/`
        );
        orderBtn.href = `mailto:col@oze.com.au?subject=${subject}&body=${body}`;
      }

      const pct = (index / (PRICING_MONTHS.length - 1)) * 100;
      if (fillEl) fillEl.style.width = `${pct}%`;
      if (glowEl) glowEl.style.left = `${pct}%`;

      document.querySelectorAll('.pricing-col').forEach((col, i) => {
        col.classList.toggle('is-active', i === index);
      });
    }

    slider.addEventListener('input', (e) => {
      updateTier(Number((e.target as HTMLInputElement).value));
    });

    columnsEl.addEventListener('click', (e) => {
      const col = (e.target as HTMLElement).closest('.pricing-col') as HTMLElement | null;
      if (col && col.dataset.index) {
        updateTier(Number(col.dataset.index));
      }
    });

    updateTier(0);
  }

  initPricing();
</script>

---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import AdnetBand from '../components/AdnetBand.astro';
import Lightbox from '../components/Lightbox.astro';
import '../styles/global.css';
import '../styles/adnet.css';

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: string;
  schema?: any;
  showAdnet?: boolean;
  adnetContext?: string;
}

const {
  title,
  description,
  canonicalUrl = `https://bellwest.au${Astro.url.pathname.replace(/\/$/, '') || '/'}`,
  ogImage = 'https://bellwest.au/images/hero-bells-beach-poster.jpg',
  ogType = 'website',
  schema,
  showAdnet = true,
  adnetContext = 'page=home',
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="en-AU" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="LulrzleF7rxUWs-Z8TcaihyEXalsS6_X06Xyk47sIj0" />
    <script is:inline>
      (function(){
        try {
          var t = localStorage.getItem('bw-theme') || 'dark';
          document.documentElement.setAttribute('data-theme', t);
        } catch(e) {}
      })();
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Social -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage.startsWith('http') ? ogImage : `https://bellwest.au${ogImage}`} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Source+Sans+3:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}
  </head>
  <body>
    <Header currentPath={currentPath} />

    <main>
      <slot />
    </main>

    {showAdnet && <AdnetBand context={adnetContext} />}

    <Footer />
    <Lightbox />

    <!-- Scroll Reveal & 3D Tilt Script -->
    <script>
      function initInteractiveEffects() {
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

        // Scroll reveal
        if (!reduceMotion && 'IntersectionObserver' in window) {
          const reveals = document.querySelectorAll('[data-reveal], .reveal-on-scroll');
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  observer.unobserve(entry.target);
                }
              });
            },
            { threshold: 0.12, rootMargin: '0px 0px -40px 0px' }
          );

          reveals.forEach((el) => observer.observe(el));
        } else {
          document.querySelectorAll('[data-reveal], .reveal-on-scroll').forEach((el) => {
            el.classList.add('is-visible');
          });
        }

        // 3D Card Tilt
        if (finePointer && !reduceMotion) {
          const tiltTargets = document.querySelectorAll(
            '.showcase-card, .utility-card, .pitch-card, .feature-card, .aside-card'
          );

          tiltTargets.forEach((card) => {
            const htmlCard = card as HTMLElement;
            let glare = htmlCard.querySelector('.tilt-glare') as HTMLElement | null;
            if (!glare) {
              glare = document.createElement('div');
              glare.className = 'tilt-glare';
              htmlCard.appendChild(glare);
            }

            const onMove = (e: MouseEvent) => {
              const rect = htmlCard.getBoundingClientRect();
              const x = e.clientX - rect.left;
              const y = e.clientY - rect.top;
              const cx = rect.width / 2;
              const cy = rect.height / 2;
              const rx = ((y - cy) / cy) * -4.5;
              const ry = ((x - cx) / cx) * 4.5;

              htmlCard.style.transform = `perspective(800px) rotateX(${rx}deg) rotateY(${ry}deg) translateY(-4px)`;
              htmlCard.style.setProperty('--mx', `${(x / rect.width) * 100}%`);
              htmlCard.style.setProperty('--my', `${(y / rect.height) * 100}%`);
              htmlCard.classList.add('is-tilting');
            };

            const onLeave = () => {
              htmlCard.style.transform = '';
              htmlCard.classList.remove('is-tilting');
            };

            htmlCard.addEventListener('mousemove', onMove);
            htmlCard.addEventListener('mouseleave', onLeave);
          });
        }
      }

      initInteractiveEffects();
    </script>

    <!-- House Ads tracking script -->
    <script async src="https://ads.oze.net.au/t.js"></script>
  </body>
</html>

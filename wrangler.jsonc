{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bellwest",
  "account_id": "ab29454df8dbb469d259956fcf482075",
  "main": "worker.js",
  "compatibility_date": "2024-09-23",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
---
import BaseLayout from '../layouts/BaseLayout.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "name": "bellwest.au",
      "url": "https://bellwest.au/",
      "description": "Premium Australian domain package bellwest.au + bellwest.com.au for sale, plus affordable promo pages and subdomains for local businesses on the Bellarine Peninsula and Great Ocean Road.",
      "publisher": {
        "@type": "Organization",
        "name": "OZ On Line",
        "url": "https://oze.au",
        "email": "col@oze.com.au"
      }
    },
    {
      "@type": "Product",
      "name": "bellwest.au Domain Package",
      "description": "Two premium .au domains (bellwest.au and bellwest.com.au) for sale at $4,000 AUD ONO. Ideal for tourism, real estate, eco-tourism or hospitality brands targeting the Bellarine & Surf Coast region.",
      "url": "https://bellwest.au/",
      "image": "https://bellwest.au/images/hero-bells-beach-poster.jpg",
      "offers": {
        "@type": "Offer",
        "price": "4000",
        "priceCurrency": "AUD",
        "availability": "https://schema.org/InStock",
        "url": "https://bellwest.au/",
        "description": "Full package including both domains, ready for transfer."
      }
    },
    {
      "@type": "Service",
      "name": "bellwest.au Promo Pages & Subdomains",
      "description": "Rent premium promo pages or subdomains (e.g. yourbusiness.bellwest.au) for local businesses, private property sales, and tourism operators. Includes custom URLs, 360° tours, drone galleries, QR codes and lead forms. From $49.50 for the first year.",
      "url": "https://bellwest.au/promo/",
      "provider": {
        "@type": "Organization",
        "name": "OZ On Line",
        "url": "https://oze.au"
      },
      "offers": {
        "@type": "Offer",
        "price": "49.50",
        "priceCurrency": "AUD",
        "description": "Introductory first-year price (regular $495 p.a.)",
        "availability": "https://schema.org/InStock",
        "url": "https://bellwest.au/promo/"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "Is bellwest.au for sale?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes — bellwest.au and bellwest.com.au are available as a package for $4,000 AUD ONO."
          }
        },
        {
          "@type": "Question",
          "name": "What is included in the domain package?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Both Australian domain names, ready for immediate transfer. No website or additional branding is included unless negotiated separately."
          }
        },
        {
          "@type": "Question",
          "name": "Can I promote my business on bellwest.au?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes. Rent a premium promo page or subdomain starting at $49.50 for your first year. Includes custom URL, 360° tours, drone galleries, QR codes and lead forms."
          }
        },
        {
          "@type": "Question",
          "name": "Are you open to partner arrangements?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Yes — we are willing to consider a partner arrangement with this project."
          }
        }
      ]
    }
  ]
};
---

<BaseLayout
  title="bellwest.au — Premium Domain For Sale | Bellarine & South West Victoria"
  description="Premium domain names bellwest.au and bellwest.com.au are for sale ($4,000 AUD ONO). Ideal for Bellarine Peninsula and South West Victoria tourism, real estate, or eco-brands."
  schema={schema}
  adnetContext="page=home"
>
  <!-- Hero -->
  <section class="hero" aria-labelledby="hero-heading">
    <div class="hero-media">
      <img
        src="/images/hero-bells-beach-poster.jpg"
        alt="Aerial panorama of Bells Beach"
        class="hero-media-poster"
        width="1920"
        height="1080"
        fetchpriority="high"
      />
      <div class="hero-overlay" aria-hidden="true"></div>
    </div>
    <div class="container hero-content">
      <p class="hero-eyebrow">Premium domain package</p>
      <h1 id="hero-heading">
        bellwest.au is for sale.<br />
        The digital gateway to the Bellarine &amp; South West.
      </h1>
      <p class="hero-lead">
        Two memorable Australian domains — <strong>bellwest.au</strong> and <strong>bellwest.com.au</strong> — positioned at the intersection of coast, country, and the Great Ocean Road corridor. Showcased with original drone photography from Bells Beach, Torquay, and Barwon Heads.
      </p>
      <div class="hero-offer">
        <span class="price">$4,000 AUD ONO</span>
        <span class="price-detail">for both domains</span>
      </div>
      <div class="hero-actions">
        <a href="mailto:col@oze.com.au?subject=bellwest.au%20domain%20inquiry" class="btn btn-primary">Inquire Now</a>
        <a href="/invest/" class="btn btn-secondary">Investment Case</a>
        <a href="/region/explore" class="btn btn-secondary">Explore the Region</a>
      </div>
    </div>
  </section>

  <!-- Domains Included Strip -->
  <section class="domains-strip" aria-label="Domains included">
    <div class="container">
      <ul class="domain-list">
        <li><span class="domain-badge">.au</span> bellwest.au</li>
        <li><span class="domain-badge">.com.au</span> bellwest.com.au</li>
      </ul>
    </div>
  </section>

  <!-- Promo Banner Strip -->
  <section class="promo-banner" aria-labelledby="promo-banner-heading">
    <div class="container promo-banner-inner">
      <div class="promo-banner-copy">
        <p class="promo-banner-eyebrow">Monetise while you wait</p>
        <h2 id="promo-banner-heading">Sell privately or promote your local business</h2>
        <p>
          Rent a premium promo page or subdomain on bellwest.au — starting at just <span class="promo-banner-price">$49.50</span> for your first year. Custom URLs, 360° tours, drone galleries, QR codes, and lead forms included.
        </p>
      </div>
      <a href="/promo/" class="btn btn-primary">View Promo Offer</a>
    </div>
  </section>

  <!-- Regional Showcase -->
  <section class="region-showcase" id="region-showcase" aria-labelledby="showcase-heading">
    <div class="container">
      <header class="section-header" data-reveal>
        <p class="section-eyebrow">Aerial photography</p>
        <h2 id="showcase-heading">Why this region sells itself</h2>
        <p class="section-lead">
          Premium coastal imagery from Bells Beach, Torquay, and Barwon Heads — the kind of visual storytelling a bellwest brand can own from day one.
        </p>
      </header>

      <div class="showcase-grid">
        <article class="showcase-card" data-reveal>
          <a href="/region/barwon-heads" class="showcase-media" aria-label="Read Barwon Heads story">
            <img
              src="/images/gallery/barwon-heads-may22.jpg"
              alt="Aerial view of Barwon Heads Bridge on the Bellarine Peninsula"
              width="1600"
              height="1066"
              loading="lazy"
            />
          </a>
          <div class="showcase-body">
            <h3>Barwon Heads — Bellarine Peninsula</h3>
            <p>Storm clouds retreating over the iconic bridge, Barwon River, and Murtnaghurt Lagoon — the western anchor of the bellwest corridor. Includes a 360° aerial tour.</p>
            <p class="showcase-links">
              <a href="/region/barwon-heads">Read on bellwest</a>
              <a href="https://coota.au/barwon-heads/" target="_blank" rel="noopener noreferrer">coota.au</a>
              <a href="/region/explore#barwon-heads">360° view</a>
            </p>
          </div>
        </article>

        <article class="showcase-card" data-reveal>
          <a href="https://coota.au/bells-beach-longboard-classic-an-aerial-odyssey/" target="_blank" rel="noopener noreferrer" class="showcase-media" aria-label="Read Bells Beach Longboard Classic on coota.au">
            <img
              src="/images/gallery/bells-longboard-pano.jpg"
              alt="180-degree aerial panorama of Bells Beach after the Longboard Classic"
              width="2560"
              height="853"
              loading="lazy"
            />
          </a>
          <div class="showcase-body">
            <h3>Bells Beach — Longboard Classic</h3>
            <p>Drone footage after the 2023 WSL World Longboard Tour event: golden late-arvo light, storm clouds rolling from the north-west, and poetic light on water. Panoramas &amp; 4K video.</p>
            <p class="showcase-links">
              <a href="https://coota.au/bells-beach-longboard-classic-an-aerial-odyssey/" target="_blank" rel="noopener noreferrer">Read on coota.au</a>
              <a href="https://youtu.be/ze7-yqh-SMM" target="_blank" rel="noopener noreferrer">Watch video</a>
              <a href="/region/explore#bells">360° view</a>
            </p>
          </div>
        </article>

        <article class="showcase-card" data-reveal>
          <a href="https://coota.au/bells-beach-may-22/" target="_blank" rel="noopener noreferrer" class="showcase-media" aria-label="Read Bells Beach calm before the storm on coota.au">
            <img
              src="/images/gallery/bells-may22-storm.jpg"
              alt="Storm clouds approaching Bells Beach at Winki Pop"
              width="1920"
              height="1080"
              loading="lazy"
            />
          </a>
          <div class="showcase-body">
            <h3>Bells Beach — calm before the storm</h3>
            <p>Glassy surf at Winki Pop carpark, two soul surfers on small swells, and storm clouds rolling in from the west. Bells isn’t just a beach — it’s a pulse, a sensation, a reverie.</p>
            <p class="showcase-links">
              <a href="https://coota.au/bells-beach-may-22/" target="_blank" rel="noopener noreferrer">Read on coota.au</a>
              <a href="https://www.youtube.com/watch?v=qetk6XZeyow" target="_blank" rel="noopener noreferrer">Watch video</a>
            </p>
          </div>
        </article>

        <article class="showcase-card" data-reveal>
          <a href="https://coota.au/torquay-may-2023/" target="_blank" rel="noopener noreferrer" class="showcase-media" aria-label="Read Torquay Fisherman's Beach on coota.au">
            <img
              src="/images/gallery/torquay-fishermans.jpg"
              alt="Aerial view of Fisherman's Beach Torquay on a bright May morning"
              width="1920"
              height="1080"
              loading="lazy"
            />
          </a>
          <div class="showcase-body">
            <h3>Torquay — Fisherman's Beach</h3>
            <p>Surfers in rhythm with the ocean, Surf Rescue zodiacs in the bay, and sun breaking through grey sky at Fisherman's Beach — the lively seaside energy of Torquay.</p>
            <p class="showcase-links">
              <a href="https://coota.au/torquay-may-2023/" target="_blank" rel="noopener noreferrer">Read on coota.au</a>
              <a href="https://youtu.be/YnTzUuwMe8I" target="_blank" rel="noopener noreferrer">Watch video</a>
              <a href="/region/explore#torquay">360° view</a>
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Local Utility Hub -->
  <section class="utility-hub" aria-labelledby="utility-heading">
    <div class="container">
      <header class="section-header" data-reveal>
        <p class="section-eyebrow">Local utility hub</p>
        <h2 id="utility-heading">Bellarine &amp; South West resources</h2>
        <p class="section-lead">
          Curated links for visitors, residents, and businesses across the Surf Coast, Bellarine Peninsula, and Great Ocean Road region.
        </p>
      </header>

      <div class="utility-grid">
        <article class="utility-card" data-reveal>
          <h3>Weather &amp; conditions</h3>
          <p>Live radar, forecasts, and surf conditions for planning your day on the coast.</p>
          <ul class="link-list">
            <li><a href="https://www.bom.gov.au/australia/radar/idr023.shtml" target="_blank" rel="noopener noreferrer">BOM — Geelong radar</a></li>
            <li><a href="https://www.bom.gov.au/places/vic/surf-coast/" target="_blank" rel="noopener noreferrer">BOM — Surf Coast forecast</a></li>
            <li><a href="https://www.surfline.com/surf-report/winkipop/5842041f4e65fad6a7708c12" target="_blank" rel="noopener noreferrer">Winki Pop surf cam</a></li>
          </ul>
        </article>

        <article class="utility-card" data-reveal>
          <h3>Government &amp; community</h3>
          <p>Council services, regional development, and community-led coastal care initiatives.</p>
          <ul class="link-list">
            <li><a href="https://www.facebook.com/groups/bellwest" target="_blank" rel="noopener noreferrer">Bellwest community on Facebook</a></li>
            <li><a href="https://www.surfcoast.vic.gov.au/" target="_blank" rel="noopener noreferrer">Surf Coast Shire</a></li>
            <li><a href="https://www.rdv.vic.gov.au/" target="_blank" rel="noopener noreferrer">Regional Development Victoria</a></li>
            <li><a href="https://www.greatoceanroaddunecare.org.au/" target="_blank" rel="noopener noreferrer">Great Ocean Road Dunecare</a></li>
          </ul>
        </article>

        <article class="utility-card" data-reveal>
          <h3>Emergency &amp; parks</h3>
          <p>Park access, track conditions, and essential services across the Otways and coastline.</p>
          <ul class="link-list">
            <li><a href="https://www.parks.vic.gov.au/places-to-see/parks/great-otway-national-park" target="_blank" rel="noopener noreferrer">Great Otway National Park</a></li>
            <li><a href="https://www.parks.vic.gov.au/" target="_blank" rel="noopener noreferrer">Parks Victoria</a></li>
            <li><a href="https://www.emergency.vic.gov.au/" target="_blank" rel="noopener noreferrer">VicEmergency</a></li>
          </ul>
        </article>

        <article class="utility-card" data-reveal>
          <h3>Walks &amp; trails</h3>
          <p>Mapped walks on the far-east Victorian coast — not the Surf Coast. Honest coverage, not an arbitrary catalogue.</p>
          <ul class="link-list">
            <li><a href="https://trailbound.au/" target="_blank" rel="noopener noreferrer">TrailBound — East Gippsland walks</a></li>
            <li><a href="https://trailbound.au/trails/" target="_blank" rel="noopener noreferrer">Trail catalogue</a></li>
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- CTA Band -->
  <section class="cta-band" aria-labelledby="cta-heading">
    <div class="container cta-band-inner" data-reveal>
      <div>
        <h2 id="cta-heading">Own the gateway to Victoria's most iconic coastline</h2>
        <p>From Geelong and the Bellarine to Torquay, Lorne, and the 12 Apostles — bellwest is a brand-ready domain package with exceptional commercial potential.</p>
      </div>
      <a href="/invest/" class="btn btn-primary">See Potential Uses</a>
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="faq" aria-labelledby="faq-heading">
    <div class="container">
      <header class="section-header" data-reveal>
        <p class="section-eyebrow">Questions</p>
        <h2 id="faq-heading">Frequently asked questions</h2>
      </header>
      <div class="faq-list" data-reveal>
        <details open>
          <summary>Is bellwest.au for sale?</summary>
          <p>Yes — <strong>bellwest.au</strong> and <strong>bellwest.com.au</strong> are available as a package for <strong>$4,000 AUD ONO</strong>.</p>
        </details>
        <details>
          <summary>What is included in the package?</summary>
          <p>Both Australian domain names, ready for immediate transfer. No website or additional branding is included unless negotiated separately.</p>
        </details>
        <details>
          <summary>Why these domains?</summary>
          <p>Short, memorable, and geographically precise. Ideal for brands targeting the Bellarine Peninsula, Surf Coast, Torquay, Bells Beach and the Great Ocean Road corridor in Victoria, Australia.</p>
        </details>
        <details>
          <summary>How do I make an offer?</summary>
          <p>Email <a href="mailto:col@oze.com.au?subject=bellwest.au%20domain%20inquiry">col@oze.com.au</a>. Serious inquiries and partnership proposals are welcome.</p>
        </details>
      </div>
    </div>
  </section>
</BaseLayout>

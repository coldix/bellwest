---
---

<div class="map-shell">
  <div id="region-map" role="img" aria-label="Interactive map of Barwon Heads, Geelong, Torquay, Bells Beach and Lorne"></div>
</div>

<ul class="map-legend" aria-label="Map locations">
  <li>Geelong — Bellarine gateway</li>
  <li>Barwon Heads — river &amp; bridge</li>
  <li>Torquay — Surf Coast beaches</li>
  <li>Bells Beach — iconic surf coast</li>
  <li>Lorne — Great Ocean Road</li>
</ul>

<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
  integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
  crossorigin=""
/>

<script is:inline src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>

<script>
  declare const L: any;

  function initMap() {
    const mapEl = document.getElementById('region-map');
    if (!mapEl || typeof L === 'undefined') return;

    const places = [
      {
        name: 'Barwon Heads',
        lat: -38.2764,
        lng: 144.4882,
        blurb: 'Bellarine Peninsula — river mouth, bridge & lagoon',
        href: '/region/barwon-heads',
        color: '#e2a72b',
      },
      {
        name: 'Geelong',
        lat: -38.1499,
        lng: 144.3617,
        blurb: 'Gateway city to the Bellarine & Surf Coast',
        href: '/region/explore',
        color: '#134e6f',
      },
      {
        name: 'Torquay',
        lat: -38.3338,
        lng: 144.3262,
        blurb: 'Surf Coast — beaches & Fisherman’s Beach',
        href: '/region/explore#torquay',
        color: '#2d8a6e',
      },
      {
        name: 'Bells Beach',
        lat: -38.3672,
        lng: 144.285,
        blurb: 'Iconic surf coast & Winki Pop',
        href: '/region/explore#bells',
        color: '#8b5cf6',
      },
      {
        name: 'Lorne',
        lat: -38.5419,
        lng: 143.9787,
        blurb: 'Great Ocean Road — Otways gateway',
        href: '/region/explore',
        color: '#1a6b8a',
      },
    ];

    const map = L.map('region-map', {
      scrollWheelZoom: false,
      zoomControl: true,
    }).setView([-38.33, 144.3], 10);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 18,
      attribution: '© <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a> contributors',
    }).addTo(map);

    places.forEach((place) => {
      const icon = L.divIcon({
        className: 'custom-map-marker',
        html: `<div style="background-color:${place.color};width:16px;height:16px;border-radius:50%;border:3px solid #ffffff;box-shadow:0 2px 8px rgba(0,0,0,0.35);"></div>`,
        iconSize: [20, 20],
        iconAnchor: [10, 10],
      });

      const marker = L.marker([place.lat, place.lng], { icon }).addTo(map);
      marker.bindPopup(`
        <div style="font-family:var(--font-body,sans-serif);padding:2px;">
          <h4 style="font-family:var(--font-display,serif);font-size:1.1rem;margin-bottom:4px;font-weight:700;">${place.name}</h4>
          <p style="font-size:0.9rem;margin-bottom:8px;color:#555;">${place.blurb}</p>
          <a href="${place.href}" style="font-size:0.9rem;font-weight:700;color:var(--brand-ink,#165c52);text-decoration:underline;">Explore location →</a>
        </div>
      `);
    });
  }

  // Handle initialization once Leaflet script is ready
  if (document.readyState === 'complete') {
    initMap();
  } else {
    window.addEventListener('load', initMap);
  }
</script>
